{
  "permissions": {
    "allow": [
      "Read({{ZEROTH_PATH}}/**)",
      "Bash(git -C {{ZEROTH_PATH}} pull:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push origin main)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh label list:*)",
      "Bash(gh label create:*)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(gh issue delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "git -C {{ZEROTH_PATH}} pull --ff-only -q || true" },
          { "type": "command", "command": "git pull --ff-only -q || true" }
        ]
      }
    ]
  }
}
